# Copy to apps/api/.env
DATABASE_URL="postgresql://koma:koma@localhost:5433/koma?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# Payments. Leave the Razorpay keys empty in development to use the built-in test mode (no real money).
# Razorpay dashboard > Account & Settings > API Keys (use TEST keys first), and Webhooks for the secret.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email (optional). Without these, emails are printed in the API log instead of sent.
RESEND_API_KEY=""
MAIL_FROM="KOMA <orders@yourdomain.in>"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
SELLER_STATE="Uttarakhand"
SELLER_GSTIN=""
COD_ENABLED=false

# Web (apps/web/.env.local)
API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_API_ORIGIN="http://localhost:4000"

# Ordering rules (optional, defaults shown)
SHIPPING_FLAT_PAISE=5000            # Rs 50 delivery fee
FREE_SHIPPING_ABOVE_PAISE=99900     # free delivery from Rs 999
ORDER_HOLD_MINUTES=30               # how long an unpaid order keeps its stock
UNSERVICEABLE_PINCODES=""           # comma-separated pincodes we do not deliver to
